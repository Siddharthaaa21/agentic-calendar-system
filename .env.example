# Copy this file to .env and fill in real values. Never commit the real .env.

# Which LLM provider to use: "anthropic" (default) or "groq"
LLM_PROVIDER=anthropic

# Required if LLM_PROVIDER=anthropic — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Required if LLM_PROVIDER=groq — get one at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.1-8b-instant

# Set to "true" to run with an in-memory mock calendar (no Google OAuth
# needed). Use this for public demo deployments so visitors can try the
# full chat -> plan -> approve -> execute loop without a Google account.
DEMO_MODE=false

# Comma-separated list of origins allowed to call the API (CORS), e.g.
# https://your-frontend.streamlit.app. Defaults to localhost origins if unset.
# Set to "*" to allow all origins (NOT recommended — the API can mutate a
# calendar and has no auth).
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Timezone that spoken times ("8pm", "tomorrow 9am") are interpreted in before
# being stored as UTC. Use an IANA name. Defaults to UTC.
APP_TIMEZONE=UTC

# --- Only needed when DEMO_MODE=false (real Google Calendar) ---
# Place your OAuth client secret as backend/credentials.json (downloaded
# from Google Cloud Console). A token.json will be generated on first run
# via an interactive browser login — this requires a local/desktop
# environment, not a headless cloud server. Because that flow blocks on a
# browser, it is DISABLED unless you explicitly opt in:
ALLOW_INTERACTIVE_AUTH=false
